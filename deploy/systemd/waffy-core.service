[Unit]
Description=waffy WAF core process (proxy + detection + enforcement)
Documentation=https://github.com/your-org/waffy
After=network.target
Wants=network.target

# Require the API companion to be alive; ok if it starts later.
# Remove this if running core standalone without the management API.
# Wants=waffy-api.service

[Service]
# ---------------- Process identity ----------------
Type=notify
User=waffy
Group=waffy
RuntimeDirectory=waffy
RuntimeDirectoryMode=0750
StateDirectory=waffy
StateDirectoryMode=0750
LogsDirectory=waffy
LogsDirectoryMode=0750

# ---------------- IPC socket ----------------
# The IPC socket path must match waffy-core's config [ipc] socket_path.
# waffy-api.service must have group "waffy" to connect.
UMask=0117

# ---------------- Executable ----------------
ExecStart=/usr/local/bin/waffy-core \
    --config /etc/waffy/config.toml

ExecReload=/bin/kill -HUP $MAINPID

# ---------------- Watchdog ----------------
# waffy-core sends sd_notify("WATCHDOG=1") every 15 seconds.
# Systemd kills and restarts the process if it goes silent for 30s.
WatchdogSec=30s

# ---------------- Restart policy ----------------
Restart=on-failure
RestartSec=5s
# Crash-loop guard: if we restart more than 5 times in 60 seconds, enter
# StartLimitAction=reboot-force is intentionally NOT used here — instead
# the unit enters failed state and the operator is alerted via journal.
StartLimitIntervalSec=60s
StartLimitBurst=5

# After StartLimitBurst is hit, this fires:
# (In practice you would wire this to an alerting hook — see docs/DEPLOYMENT.md)

# ---------------- Capabilities ----------------
# CAP_NET_BIND_SERVICE is only needed when waffy-core listens on ports <1024
# (e.g. standalone TLS mode on 443).  If running behind a reverse proxy or
# on a high port, remove this line.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# ---------------- Hardening ----------------
# Filesystem isolation
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=no   # must be no when using AmbientCapabilities

# Proc/kernel hardening
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# No privilege escalation
NoNewPrivileges=yes
SecureBits=noroot

# Limit syscalls (basic safe set — extend if waffy-core uses additional syscalls)
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@debug @mount @cpu-emulation @obsolete @privileged @resources @reboot @swap

# Writable paths: only the state/runtime/logs dirs declared above
ReadWritePaths=/run/waffy /var/lib/waffy /var/log/waffy
ReadOnlyPaths=/etc/waffy

# IPC limits
LimitNOFILE=65536
LimitNPROC=256

# Memory guard: OOM killer score adjustment (lower = less likely to be killed)
OOMScoreAdjust=-100

# Networking
IPAccounting=yes

[Install]
WantedBy=multi-user.target
